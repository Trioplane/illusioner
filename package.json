{
  "name": "illusioner",
  "displayName": "Illusioner",
  "description": "Formats your long commands",
  "version": "0.0.3",
  "keywords": [
    "datapacks",
    "mcfunction",
    "minecraft",
    "minecraft java",
    "minecraft commands"
  ],
  "publisher": "trplnr",
  "license": "MIT",
  "homepage": "https://github.com/Trioplane/illusioner",
  "bugs": {
    "email": "triopane30@gmail.com",
    "url": "https://github.com/Trioplane/illusioner/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Trioplane/illusioner.git"
  },
  "author": {
    "name": "Trplnr"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:mcfunction"
  ],
  "main": "./out/main.js",
  "contributes": {
    "configuration": [
      {
        "title": "Illusioner",
        "properties": {
          "illusioner.indentSize": {
            "type": "integer",
            "default": 4,
            "description": "Sets how long the indent for the formatting is. Measured in spaces."
          }
        }
      }
    ],
    "languages": [
      {
        "id": "mcfunction",
        "aliases": [
          "mcfunction"
        ],
        "extensions": [
          ".mcfunction"
        ]
      }
    ]
  },
  "preview": true,
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "test-compile": "tsc -p ./"
},
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@types/whatwg-url": "^13.0.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "0.25.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@spyglassmc/core": "^0.4.23",
    "@spyglassmc/java-edition": "^0.3.28",
    "@spyglassmc/mcfunction": "^0.2.24",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
